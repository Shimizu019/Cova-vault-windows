{
  "name": "cova-vault-windows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cova Vault - Windows desktop application (Tauri 2 + React + TypeScript).",
  "license": "MIT",
  "author": "Benju Guzman",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icon:source": "python scripts/make-icon-source.py",
    "icon:generate": "tauri icon src-tauri/icons/icon-source.png",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
